# 统一按 LF 存储，避免 Windows / macOS 之间整文件 diff
* text=auto eol=lf

# 二进制文件不做换行转换，也不做文本 diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.exe  binary
*.dll  binary
*.zip  binary
*.7z   binary

# Windows 脚本保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 让 GitHub 把这些文件识别为纯文本统计
package-lock.json linguist-generated=true

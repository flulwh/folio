{
  "name": "immersive-reader",
  "version": "2.14.0",
  "description": "A minimalist, immersive e-book reader built with Electron and React.",
  "license": "MIT",
  "author": "Folio contributors",
  "engines": {
    "node": ">=18.17"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev --noSandbox",
    "dev:vite": "electron-vite dev --rendererOnly",
    "start": "node scripts/start-electron.mjs",
    "check": "node scripts/verify-release.mjs && node scripts/verify-docs.mjs && npm run lint && npm run test",
    "lint": "eslint .",
    "test": "vitest run",
    "check:theme": "node tools/_theme-sync.mjs",
    "check:lan-edge": "node tools/_run-lan-edge.mjs",
    "check:lan-sync": "node tools/_lan-sync-check.mjs",
    "build:vite": "electron-vite build",
    "build": "electron-vite build && node scripts/build-win.mjs",
    "build:dir": "node scripts/build-win.mjs --win dir",
    "build:portable": "node scripts/build-win.mjs --win portable",
    "build:nsis": "node scripts/build-win.mjs --win nsis",
    "build:zip": "node scripts/build-win.mjs --win zip",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@vepando/liquid-glass-react": "^1.3.0",
    "cheerio": "^1.2.0",
    "css-select": "^7.0.0",
    "foliate-js": "^1.0.1",
    "fontkit": "^3.0.0",
    "lowdb": "^7.0.1",
    "lucide-react": "^1.77.0",
    "motion": "^12.43.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-zoom-pan-pinch": "^4.4.0",
    "sonner": "^2.0.8",
    "xpath": "^0.0.36",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^45.4.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.flulwh.folio",
    "productName": "Folio",
    "copyright": "Copyright © 2026 Folio contributors",
    "artifactName": "Folio-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "electron/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip",
        "dir"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "Folio"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Folio",
      "artifactName": "Folio-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Folio-Portable-${version}.${ext}",
      "requestExecutionLevel": "user"
    }
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  }
}

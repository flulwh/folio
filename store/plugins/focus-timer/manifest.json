{
  "id": "focus-timer",
  "name": "专注计时",
  "version": "1.0.0",
  "apiVersion": 1,
  "description": "番茄钟：专注一轮、休息一下，把今天读了几轮记下来。",
  "author": "Folio",
  "main": "main.js",
  "permissions": [
    "ui",
    "notify",
    "settings"
  ],
  "settings": [
    {
      "key": "focusMinutes",
      "label": "每轮时长（分钟）",
      "type": "number",
      "default": 25,
      "min": 5,
      "max": 120
    },
    {
      "key": "breakMinutes",
      "label": "休息时长（分钟，0 为不休）",
      "type": "number",
      "default": 5,
      "min": 0,
      "max": 30
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "start",
        "title": "开始专注"
      },
      {
        "id": "open",
        "title": "打开计时器"
      },
      {
        "id": "today",
        "title": "今天读了几轮"
      }
    ],
    "ui": {
      "panels": [
        {
          "id": "timer",
          "title": "番茄钟",
          "slot": "overlay",
          "width": "normal",
          "icon": "⏱"
        }
      ]
    }
  }
}

{
  "id": "quote-book",
  "name": "书摘本",
  "version": "1.0.0",
  "apiVersion": 1,
  "description": "随手记下句子，随机抽一句、一键复制，都放在插件自己的存储里。",
  "author": "Folio",
  "main": "main.js",
  "permissions": [
    "ui",
    "notify",
    "clipboard"
  ],
  "settings": [
    {
      "key": "showOnOpen",
      "label": "打开面板时随机展示一句",
      "type": "boolean",
      "default": true
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "open",
        "title": "打开书摘本"
      },
      {
        "id": "random",
        "title": "随机来一句"
      }
    ],
    "ui": {
      "panels": [
        {
          "id": "quotes",
          "title": "书摘",
          "slot": "overlay",
          "width": "wide",
          "icon": "❝"
        }
      ]
    }
  }
}

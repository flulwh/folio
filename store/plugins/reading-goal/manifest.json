{
  "id": "reading-goal",
  "name": "阅读目标",
  "version": "1.0.0",
  "apiVersion": 1,
  "description": "给每天定一个阅读时长目标，记录连续天数，完成时提醒你。",
  "author": "Folio",
  "main": "main.js",
  "permissions": [
    "ui",
    "notify",
    "settings"
  ],
  "settings": [
    {
      "key": "dailyMinutes",
      "label": "每日目标（分钟）",
      "type": "number",
      "default": 30,
      "min": 5,
      "max": 300
    },
    {
      "key": "notifyOnDone",
      "label": "完成目标时提醒",
      "type": "boolean",
      "default": true
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "open",
        "title": "打开阅读目标"
      },
      {
        "id": "today",
        "title": "今天读了多少"
      }
    ],
    "ui": {
      "panels": [
        {
          "id": "goal",
          "title": "今日目标",
          "slot": "shelf",
          "width": "normal",
          "icon": "◎"
        }
      ]
    }
  }
}
